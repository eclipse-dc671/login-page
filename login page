<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eclipse Portal - Access</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #05070a;
      --theme: #00ff66; /* डिफ़ॉल्ट ग्रीन थीम */
      --theme-glow: rgba(0, 255, 102, 0.4);
      --text: #f3f1ec;
      --muted: #8d8b86;
      --field: rgba(255, 255, 255, 0.05);
      --line: rgba(255, 255, 255, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      padding: 80px 16px 30px;
      position: relative;
    }

    /* बैकग्राउंड कैनवस */
    #canvasBg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* कलर स्विचर बार */
    .color-bar {
      position: fixed;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(10, 14, 18, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 8px 16px;
      border-radius: 999px;
      border: 1px solid var(--line);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    }

    .palette {
      display: flex;
      gap: 8px;
    }

    .dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.2s, border-color 0.2s;
    }

    .dot:hover {
      transform: scale(1.15);
    }

    .dot.active {
      border-color: #fff;
      box-shadow: 0 0 10px var(--theme);
    }

    /* कस्टम कलर व्हील पिकर */
    .custom-picker {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      position: relative;
      overflow: hidden;
      background: conic-gradient(#f44, #fd4, #4f6, #4df, #84f, #f4a, #f44);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3);
      cursor: pointer;
    }

    .custom-picker input {
      position: absolute;
      inset: -10px;
      opacity: 0;
      cursor: pointer;
    }

    /* कट-कॉर्नर कार्ड */
    .card-stage {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 440px;
    }

    .card-border {
      padding: 1px;
      clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);
      background: linear-gradient(150deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.06) 40%, var(--theme));
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
      transition: background 0.3s;
    }

    .card-body {
      clip-path: polygon(29px 0, 100% 0, 100% calc(100% - 29px), calc(100% - 29px) 100%, 0 100%, 0 29px);
      background: linear-gradient(160deg, rgba(16, 22, 28, 0.85), rgba(6, 8, 10, 0.95));
      backdrop-filter: blur(24px) saturate(1.2);
      -webkit-backdrop-filter: blur(24px) saturate(1.2);
      padding: 34px 28px 28px;
    }

    h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    h1 span {
      color: var(--theme);
      transition: color 0.3s;
    }

    .sub {
      font-size: 13px;
      color: var(--muted);
      margin: 8px 0 22px;
      line-height: 1.5;
    }

    /* इनपुट्स */
    .field-group {
      margin-bottom: 14px;
    }

    label {
      display: block;
      font-size: 12.5px;
      font-weight: 500;
      color: #cfcdc8;
      margin-bottom: 6px;
    }

    .field-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .field-wrap input {
      width: 100%;
      height: 46px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--field);
      
